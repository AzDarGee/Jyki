<%# Collaborator ACL Roster Card %>
<div id="<%= dom_id(collaborator) %>"
     class="p-2.5 rounded-md bg-[#0b0b0d] border border-[#1f1e1c] flex items-center justify-between gap-2">
  <div class="min-w-0 flex-1">
    <div class="flex items-center gap-2">
      <span class="text-xs font-semibold text-[#f4f4f0] font-mono truncate">@<%= collaborator.username %></span>
      <span class="text-[10px] font-mono text-[#5e5b56] truncate"><%= collaborator.external_user_id %></span>
    </div>
    <div class="text-[10px] font-mono text-[#7c7872] truncate mt-0.5">
      <%= collaborator.email %> · <%= collaborator.added_at_label %>
    </div>
  </div>

  <div class="flex items-center gap-2 shrink-0">
    <span class="px-2 py-0.5 rounded text-[9px] font-mono uppercase bg-[#1a1816] border border-[#3a342e] text-[#c4bfb6]">
      <%= collaborator.role %>
    </span>

    <%= button_to studio_auth_collaborator_path(collaborator),
          method: :delete,
          form: { data: { turbo: true }, class: "inline" },
          aria: { label: "Revoke access for @#{collaborator.username}" },
          title: "Revoke collaborator access",
          class: "text-[#7c7872] hover:text-[#f87171] text-xs px-1 cursor-pointer transition-colors" do %>
      🗑
    <% end %>
  </div>
</div>

