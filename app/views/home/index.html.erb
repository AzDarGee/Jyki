<div class="min-h-screen bg-slate-950 flex items-center justify-center p-6">
  <div class="saanskara-test-card">

    <span class="badge-pill">
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
      Spanda Active • Rails <%= Rails.version %>
    </span>

    <h1 class="title-sanskrit">
      Saanskara Studio Pipeline
    </h1>

    <p class="text-slate-300 text-sm leading-relaxed mt-2">
      If this card has a glowing saffron border that shifts to lotus-crimson when you hover,
      your <code class="text-amber-400 font-mono">SCSS &rarr; Tailwind v4 &rarr; Propshaft</code>
      alchemical pipeline is officially firing on all cylinders.
    </p>

    <div class="status-grid">
      <div class="status-item">
        <span class="label">SCSS Mixins</span>
        <span class="value">✓ Compiled</span>
      </div>
      <div class="status-item">
        <span class="label">Tailwind v4</span>
        <span class="value">✓ Purged</span>
      </div>
      <div class="status-item">
        <span class="label">Node.js RAM</span>
        <span class="value">0 MB</span>
      </div>
    </div>

  </div>
</div>