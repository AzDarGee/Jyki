<%# Channel Strip Card in Zone E %>
<div class="flex-1 min-w-[180px] max-w-[240px] bg-[#111315] border <%= track[:selected] ? 'border-[#5c3d1e]' : 'border-[#22252a]' %> rounded p-3 flex flex-col justify-between transition-colors cursor-pointer"
     data-mixer-target="channelStripCard"
     data-track-id="<%= track[:id] %>"
     data-track-name="<%= track[:name] %>"
     data-action="click->mixer#selectTrack">
  <%# Top Header: Track Name + AUDIO/MIDI/BUS Badge %>
  <div class="flex items-center justify-between gap-2">
    <span class="text-xs font-semibold text-[#f4f4f0] truncate" title="<%= track[:name] %>">
      <%= track[:mixer_name] || track[:name] %>
    </span>
    <span class="px-1.5 py-0.5 rounded bg-[#231911] border border-[#5c3d1e] font-mono text-[9px] font-semibold text-[#f59e0b] uppercase shrink-0">
      <%= track[:badge] %>
    </span>
  </div>

  <%# Middle Controls: Horizontal GAIN Slider & PAN Slider %>
  <div class="my-2">
    <div class="flex items-center justify-between font-mono text-[9px] text-[#8e8a83] mb-1">
      <span>GAIN</span>
      <span data-mixer-target="stripPanLabel" data-track-id="<%= track[:id] %>">PAN (<%= track[:pan] %>)</span>
    </div>

    <div class="grid grid-cols-2 gap-2.5 items-center">
      <%# GAIN Slider %>
      <div class="flex items-center">
        <input type="range"
               min="-24"
               max="6"
               step="0.1"
               value="<%= track[:gain_db] %>"
               aria-label="<%= track[:name] %> Mixer Gain"
               data-track-id="<%= track[:id] %>"
               data-default-value="0.0"
               data-mixer-target="stripGainSlider"
               data-action="input->mixer#updateTrackGain dblclick->mixer#resetFader:stop"
               class="jaku-fader w-full" />
      </div>

      <%# PAN Slider %>
      <div class="flex items-center">
        <input type="range"
               min="-50"
               max="50"
               step="1"
               value="<%= track[:pan] %>"
               aria-label="<%= track[:name] %> Mixer Pan"
               data-track-id="<%= track[:id] %>"
               data-default-value="0"
               data-mixer-target="stripPanSlider"
               data-action="input->mixer#updateTrackPan dblclick->mixer#resetPan:stop"
               class="jaku-fader w-full" />
      </div>
    </div>
  </div>

  <%# Bottom Status Row: FX count & cyan ⚡ NR ON / ⚡ DIRECT %>
  <div class="flex items-center justify-between pt-1.5 border-t border-[#1c1f24] font-mono text-[9px]">
    <span class="text-[#8e8a83]">FX <%= track[:fx_active] %>/<%= track[:fx_total] %></span>
    <span data-mixer-target="stripModeBadge"
          data-track-id="<%= track[:id] %>"
          class="text-[#2dd4bf] font-semibold flex items-center gap-1">
      <span>⚡</span>
      <span><%= track[:mode_badge] %></span>
    </span>
  </div>
</div>

