<%# Panel 1: 💬 Chat / DM %>
<% chat_messages = local_assigns[:chat_messages] || StudioChatMessage.default_messages_for("project_room") %>

<%# Subscribe to Solid Cable real-time stream %>
<%= turbo_stream_from "jyki_project_chat" %>

<%# 2A. Panel Header %>
<div class="h-9 px-3 border-b border-[#1f1d1b] flex items-center justify-between shrink-0">
  <div class="text-xs font-semibold text-[#f4f4f0] flex items-center gap-1.5">
    <span class="text-[#f3be7a]">💬</span>
    <span>Chat / DM</span>
  </div>
  <button type="button"
          data-action="click->right-sidebar#toggleDock"
          aria-label="Collapse Chat Sidebar"
          title="Collapse Sidebar"
          class="w-6 h-6 rounded border border-[#262320] bg-[#141416] text-zinc-400 hover:text-white flex items-center justify-center text-[10px] font-mono cursor-pointer transition-colors">
    |▷
  </button>
</div>

<%# 2B. Sub-Mode Segmented Switcher (Project Room | Direct Message (DM)) %>
<div class="grid grid-cols-2 gap-1.5 p-2.5 border-b border-[#191816] shrink-0">
  <button type="button"
          data-chat-submode="project_room"
          data-right-sidebar-target="chatSubmodeButton"
          data-action="click->right-sidebar#switchChatSubmode"
          class="py-1 px-2.5 rounded text-[11px] font-medium bg-[#18181b] border border-[#2e2c29] text-[#f4f4f0] text-center cursor-pointer transition">
    Project Room
  </button>
  <button type="button"
          data-chat-submode="dm"
          data-right-sidebar-target="chatSubmodeButton"
          data-action="click->right-sidebar#switchChatSubmode"
          class="py-1 px-2.5 rounded text-[11px] font-medium bg-[#111113] border border-[#1f1e1c] text-[#7c7872] hover:text-[#e5e2dc] text-center cursor-pointer transition">
    Direct Message (DM)
  </button>
</div>

<%# Compact Collaborator Selector Bar (Visible when Direct Message (DM) is active) %>
<div data-right-sidebar-target="dmCollaboratorBar"
     class="hidden px-2.5 py-1.5 border-b border-[#191816] bg-[#101012] items-center justify-between gap-1.5 shrink-0">
  <span class="text-[10px] font-mono text-[#7c7872] uppercase">DM TO:</span>
  <div class="flex items-center gap-1">
    <button type="button"
            data-dm-recipient="aria_mastering"
            data-right-sidebar-target="dmRecipientPill"
            data-action="click->right-sidebar#selectDmRecipient"
            class="px-2 py-0.5 rounded text-[10px] font-mono bg-[#231911] border border-[#6b4926] text-[#f3be7a] cursor-pointer">
      @aria_mastering
    </button>
    <button type="button"
            data-dm-recipient="devon_synth"
            data-right-sidebar-target="dmRecipientPill"
            data-action="click->right-sidebar#selectDmRecipient"
            class="px-2 py-0.5 rounded text-[10px] font-mono bg-[#141416] border border-[#262320] text-[#8e8a83] hover:text-[#e5e2dc] cursor-pointer">
      @devon_synth
    </button>
  </div>
</div>

<%# 2C. Scrollable Message Stream (#jyki_chat_messages) %>
<div id="jyki_chat_messages"
     data-right-sidebar-target="chatMessagesList"
     class="flex-1 overflow-y-auto p-2.5 space-y-2">
  <%= render partial: "workstation/sidebar/chat_message", collection: chat_messages, as: :message %>
</div>

<%# 2D. Bottom Chat Composer Bar %>
<div class="p-2.5 border-t border-[#1f1d1b] bg-[#0b0a09] shrink-0">
  <%= form_with url: studio_chat_messages_path,
        scope: :chat_message,
        method: :post,
        data: { turbo: true, action: "turbo:submit-end->right-sidebar#resetChatInput" },
        class: "flex items-center gap-1.5" do |f| %>
    <%= f.hidden_field :room_type, value: "project_room", data: { right_sidebar_target: "chatRoomTypeInput" } %>
    <%= f.hidden_field :recipient_handle, value: "", data: { right_sidebar_target: "chatRecipientInput" } %>
    <%= f.text_field :body,
          required: true,
          autocomplete: "off",
          placeholder: "Message project collaborators...",
          aria_label: "Message project collaborators",
          data: { right_sidebar_target: "chatBodyInput" },
          class: "flex-1 bg-[#121215] border border-[#262320] focus:border-[#6b4926] focus:outline-none rounded px-2.5 py-1.5 text-xs text-[#e5e2dc] placeholder-[#6e6a64]" %>
    <button type="submit"
            aria-label="Send chat message"
            title="Send Message"
            class="w-8 h-7 rounded bg-[#d8b98a] hover:bg-[#e3c79c] text-[#0c0b0a] flex items-center justify-center cursor-pointer transition shrink-0">
      <span class="text-xs leading-none">◁</span>
    </button>
  <% end %>
</div>

