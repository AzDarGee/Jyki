<%# Panel 4: ✨ Notes / Studio AI (Studio Notes & Patch Scratchpad + Gemini Studio AI Lab) %>
<%# Panel Header %>
<div class="h-9 px-3 border-b border-[#1f1d1b] flex items-center justify-between shrink-0">
  <div class="text-xs font-semibold text-[#f4f4f0] flex items-center gap-1.5">
    <span class="text-[#f59e0b]">✨</span>
    <span>AI Lab &amp; Studio Notes</span>
  </div>
  <button type="button"
          data-action="click->right-sidebar#toggleDock"
          aria-label="Collapse Notes and AI Sidebar"
          title="Collapse Sidebar"
          class="w-6 h-6 rounded border border-[#262320] bg-[#141416] text-zinc-400 hover:text-white flex items-center justify-center text-[10px] font-mono cursor-pointer transition-colors">
    |▷
  </button>
</div>

<div class="p-3 flex-1 overflow-y-auto flex flex-col gap-3" data-zone="ai-lab" data-workstation-target="aiLabPanel">
  <%# Card 1: Studio Notes & Patch Scratchpad %>
  <div class="p-3 rounded-lg bg-[#121215] border border-[#222120] flex flex-col gap-2.5">
    <div class="flex items-center justify-between">
      <span class="text-xs font-semibold text-[#f4f4f0]">Studio Notes &amp; Patch Scratchpad</span>
      <span class="text-[10px] font-mono text-[#2dd4bf]">AUTO-SYNC</span>
    </div>

    <%= form_with url: right_sidebar_save_note_path,
          scope: :studio_note,
          method: :post,
          data: { turbo: true },
          class: "flex flex-col gap-2" do |f| %>
      <div class="flex items-center justify-between gap-2 text-[10px] font-mono">
        <span class="text-[#7c7872]">TUNING REF / SUB KEY</span>
        <%= f.select :tuning_hz,
              [ [ "440 Hz · F Minor (8A)", "440 Hz" ], [ "432 Hz · Raga Bhairav", "432 Hz" ], [ "444 Hz · C# Sub Lock", "444 Hz" ] ],
              { selected: "440 Hz" },
              aria_label: "Tuning frequency reference",
              class: "px-2 py-0.5 rounded bg-[#09090b] border border-[#262320] text-[10px] font-mono text-[#f3be7a] focus:outline-none cursor-pointer" %>
      </div>

      <%= f.text_area :content,
            rows: 3,
            aria_label: "Studio mix notes and patch scratchpad",
            value: "Sub-bass 808 fundamental @ 43.65 Hz (F1). Keep Buchla pluck high-passed @ 180 Hz; tape saturation drive +2.4 dB.",
            class: "w-full rounded bg-[#09090b] border border-[#242220] focus:border-[#6b4926] focus:outline-none p-2 text-[11px] font-mono text-[#d4d0c8] leading-relaxed resize-none" %>

      <div class="flex items-center justify-between gap-2">
        <span id="studio_note_save_status" class="text-[10px] font-mono text-[#7c7872] truncate">
          ✔ Synced to /projects/proj_default
        </span>
        <button type="submit"
                data-turbo-submits-with="Saving..."
                class="px-2.5 py-1 rounded bg-[#18181b] hover:bg-[#222226] border border-[#2e2c29] text-[10px] font-mono text-[#e5e2dc] cursor-pointer transition shrink-0">
          Save Note
        </button>
      </div>
    <% end %>
  </div>

  <%# Card 2: Gemini Studio Intelligence (AI Lab) %>
  <div class="p-3 rounded-lg bg-[#121215] border border-[#222120] space-y-2.5">
    <div class="flex items-center justify-between text-[10px] font-mono">
      <span class="text-[#8e8a83]">Gemini Studio<br>Intelligence</span>
      <div class="text-right">
        <div class="text-[#e5c185]">gemini-4-argon</div>
        <div class="text-[#8e8a83] text-[9px]">(Global Layout AI)</div>
      </div>
    </div>

    <div class="grid grid-cols-3 gap-1 bg-[#141312] p-0.5 rounded border border-[#262320]">
      <button type="button"
              data-ai-mode="Mix Critic"
              data-workstation-target="aiModeButton"
              data-action="click->workstation#switchAiMode"
              class="h-6 rounded-xs text-[10px] font-medium flex items-center justify-center gap-1 cursor-pointer bg-[#231911] text-[#f5a623] border border-[#5c3d1e]">
        <span>🎛</span>
        <span>Mix Critic</span>
      </button>
      <button type="button"
              data-ai-mode="Idea Gen"
              data-workstation-target="aiModeButton"
              data-action="click->workstation#switchAiMode"
              class="h-6 rounded-xs text-[10px] font-medium flex items-center justify-center gap-1 cursor-pointer text-[#8e8a83] hover:text-[#e5e2dc] border border-transparent">
        <span>💡</span>
        <span>Idea Gen</span>
      </button>
      <button type="button"
              data-ai-mode="Producer"
              data-workstation-target="aiModeButton"
              data-action="click->workstation#switchAiMode"
              class="h-6 rounded-xs text-[10px] font-medium flex items-center justify-center gap-1 cursor-pointer text-[#8e8a83] hover:text-[#e5e2dc] border border-transparent">
        <span>🎙</span>
        <span>Producer</span>
      </button>
    </div>

    <div>
      <textarea rows="3"
                aria-label="AI Mix Analysis Prompt"
                data-workstation-target="aiPromptInput"
                class="w-full rounded bg-[#09090b] border border-[#262320] focus:border-[#5c3d1e] focus:outline-none p-2 text-[11px] text-[#e5e2dc] leading-relaxed resize-none">Analyze my 128 BPM sub bass and granular pad routing for phase cancellation and suggest mastering EQ settings.</textarea>
    </div>

    <button type="button"
            data-action="click->workstation#runAiMixAnalysis"
            data-workstation-target="aiRunButton"
            class="w-full h-8 rounded bg-[#d6b88a] hover:bg-[#e3c79b] text-[#09090b] font-semibold text-[11px] flex items-center justify-center gap-1.5 cursor-pointer transition-colors shadow-xs">
      <span data-workstation-target="aiRunLabel">Run Deep Mix Analysis (gemini-4-argon)</span>
    </button>

    <div id="ai_lab_response" data-workstation-target="aiResponseBox" class="text-[10px] font-mono text-[#8e8a83]"></div>

    <div class="pt-2 border-t border-[#1f1d1b] space-y-1.5">
      <div class="flex items-center justify-between text-[10px] font-mono">
        <span class="text-[#e5e2dc] font-sans font-medium">Voice Memo Transcriber</span>
        <span class="text-[#8e8a83]">gemini-4-transcribe</span>
      </div>
      <div class="text-[10px] text-[#8e8a83]" data-workstation-target="micStatusLabel">
        Ready for mic voice-note
      </div>
      <button type="button"
              data-action="click->workstation#toggleVoiceTranscriber"
              data-workstation-target="micTranscribeButton"
              class="w-full h-7 rounded bg-[#161514] border border-[#262320] hover:border-[#4a3520] text-[#e5e2dc] text-[11px] flex items-center justify-center gap-1.5 cursor-pointer transition-colors">
        <span class="text-[#ef4444]">🎙</span>
        <span data-workstation-target="micButtonLabel">Record &amp; Transcribe Mic Audio</span>
      </button>
    </div>
  </div>
</div>

