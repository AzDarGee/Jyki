<%# Panel 3: 📱 Remote (Mobile Companion Remote) %>
<%# 4A. Panel Header %>
<div class="h-9 px-3 border-b border-[#1f1d1b] flex items-center justify-between shrink-0">
  <div class="text-xs font-semibold text-[#f4f4f0] flex items-center gap-1.5">
    <span class="text-[#f3be7a]">📱</span>
    <span>Remote</span>
  </div>
  <button type="button"
          data-action="click->right-sidebar#toggleDock"
          aria-label="Collapse Remote Sidebar"
          title="Collapse Sidebar"
          class="w-6 h-6 rounded border border-[#262320] bg-[#141416] text-zinc-400 hover:text-white flex items-center justify-center text-[10px] font-mono cursor-pointer transition-colors">
    |▷
  </button>
</div>

<%# 4B. Mobile Companion Remote Body %>
<div class="p-3 flex-1 overflow-y-auto">
  <div class="p-3.5 rounded-lg bg-[#121215] border border-[#222120] flex flex-col gap-3">
    <%# Card Header %>
    <div class="flex items-center justify-between">
      <span class="text-xs font-semibold text-[#f4f4f0]">Mobile Companion Remote</span>
      <span class="text-[10px] font-mono font-semibold text-[#2dd4bf] flex items-center gap-1">
        <span>✔</span>
        <span>PAIRED</span>
      </span>
    </div>

    <%# 3 Telemetry Key-Value Rows %>
    <div class="space-y-2 text-[11px] font-mono pt-1">
      <div class="flex items-center justify-between">
        <span class="text-[#7c7872]">DEVICE</span>
        <span class="text-[#f4f4f0] font-semibold">iPhone 17 Pro · Studio Remote</span>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-[#7c7872]">ROUNDTRIP SYNC</span>
        <span id="companion_roundtrip_sync"
              data-right-sidebar-target="roundtripSyncReadout"
              class="text-[#2dd4bf] font-semibold">3.8 ms</span>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-[#7c7872]">REMOTE TRANSPORT</span>
        <span class="text-[#e5e2dc]">ARMED · LOW-LATENCY MON</span>
      </div>
    </div>

    <%# Bottom Full-Width Action Button %>
    <%= button_to right_sidebar_refresh_telemetry_path,
          method: :post,
          form: { data: { turbo: true } },
          data: { turbo_submits_with: "Pinging Companion..." },
          class: "w-full mt-1 py-1.5 px-3 rounded bg-[#18181b] hover:bg-[#222226] border border-[#2e2c29] text-[11px] font-mono text-[#e5e2dc] text-center transition cursor-pointer" do %>
      Refresh Companion Telemetry
    <% end %>
  </div>
</div>

