<%# Column 1: Left Sound Browser %>
<aside class="w-64 border-r border-[#221f1d] bg-[#0e0d0c] flex flex-col p-2.5 shrink-0"
       data-zone="sound-browser"
       data-workstation-target="soundBrowser"
       aria-label="Sound Libraries and Plugins Browser">
  <%# Header %>
  <div class="flex items-center justify-between mb-2">
    <h2 class="text-[11px] font-semibold text-[#e5e2dc] flex items-center gap-1.5 tracking-tight">
      <span class="text-[#f59e0b]">📂</span>
      <span>Sound Libraries & Plugins</span>
    </h2>
  </div>

  <%# Search Input %>
  <div class="mb-2">
    <input type="text"
           placeholder="Filter samples, VST3, AU..."
           aria-label="Filter samples, VST3, AU"
           data-workstation-target="librarySearch"
           data-action="input->workstation#filterLibrary"
           class="w-full h-7 px-2.5 rounded bg-[#161514] border border-[#262320] focus:border-[#4a3520] focus:outline-none text-xs text-[#f4f4f0] placeholder-[#8e8a83]" />
  </div>

  <%# Segmented Toggle: Library (active) | My Samples %>
  <div class="grid grid-cols-2 bg-[#141312] p-0.5 rounded border border-[#262320] mb-2.5"
       role="tablist"
       aria-label="Sound Library Source">
    <button type="button"
            role="tab"
            aria-selected="true"
            data-library-tab="library"
            data-workstation-target="libraryTabButton"
            data-action="click->workstation#switchLibraryTab"
            class="h-6 rounded-xs text-[11px] font-medium transition-colors cursor-pointer bg-[#232220] text-[#f4f4f0] border border-[#3a3632]">
      Library
    </button>
    <button type="button"
            role="tab"
            aria-selected="false"
            data-library-tab="my_samples"
            data-workstation-target="libraryTabButton"
            data-action="click->workstation#switchLibraryTab"
            class="h-6 rounded-xs text-[11px] font-medium transition-colors cursor-pointer text-[#8e8a83] hover:text-[#e5e2dc] border border-transparent">
      My Samples
    </button>
  </div>

  <%# Scrollable Item Cards (draggable onto the timeline) %>
  <div class="flex-1 overflow-y-auto space-y-1.5 pr-0.5" data-workstation-target="libraryList">
    <% library_items.each do |item| %>
      <div draggable="true"
           data-workstation-target="libraryCard"
           data-category="<%= item[:category] %>"
           data-title="<%= item[:title].downcase %>"
           data-subtitle="<%= item[:subtitle].downcase %>"
           data-item-title="<%= item[:title] %>"
           data-item-kind="<%= item[:kind] %>"
           data-action="click->workstation#selectLibraryItem dragstart->workstation#dragStartLibraryItem"
           class="<%= item[:category] == 'my_samples' ? 'hidden' : '' %> p-2.5 rounded cursor-grab active:cursor-grabbing transition-all <%= item[:active] ? 'bg-[#171411] border border-[#5c3d1e] shadow-[inset_0_0_0_1px_rgba(217,119,6,0.12)]' : 'bg-[#121214] border border-[#22201e] hover:border-[#3d352e]' %>">
        <div class="text-xs font-semibold text-[#f4f4f0] leading-snug truncate">
          <%= item[:title] %>
        </div>
        <div class="text-[10px] font-mono text-[#8e8a83] mt-0.5">
          <%= item[:subtitle] %>
        </div>
      </div>
    <% end %>
  </div>
</aside>

